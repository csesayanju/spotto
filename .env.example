# Copy to .env and fill from Firebase console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional, from the same screen once Google Analytics is enabled (G-XXXXXXX)
VITE_FIREBASE_MEASUREMENT_ID=
