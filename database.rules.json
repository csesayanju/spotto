{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["meta/createdAt"],
      "$code": {
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || (!newData.exists() && data.child('meta/createdAt').val() < now - 21600000))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
