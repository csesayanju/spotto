{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".indexOn": [
        "meta/createdAt"
      ],
      "$code": {
        ".write": "auth != null && ((!data.exists() && root.child('config/open').val() !== false) || data.child('players').child(auth.uid).exists() || (!newData.exists() && data.child('meta/createdAt').val() < now - 21600000))",
        ".validate": "$code.matches(/^[A-Z]{4}$/) && newData.hasChildren(['meta'])",
        "meta": {
          ".validate": "newData.hasChildren(['hostId', 'status', 'mode', 'createdAt'])",
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'finished'"
          },
          "mode": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || !newData.exists() || (root.child('config/open').val() !== false && root.child('rooms').child($code).child('meta/status').val() === 'lobby'))",
            ".validate": "newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "reaction": {
              ".validate": "newData.hasChildren(['emoji', 'at'])",
              "emoji": {
                ".validate": "newData.isString() && newData.val().length <= 8"
              },
              "at": {
                ".validate": "newData.isNumber()"
              }
            }
          }
        },
        "spectators": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || !newData.exists() || (root.child('config/open').val() !== false && root.child('rooms').child($code).child('meta').exists()))",
            ".validate": "newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "reaction": {
              ".validate": "newData.hasChildren(['emoji', 'at'])",
              "emoji": {
                ".validate": "newData.isString() && newData.val().length <= 8"
              },
              "at": {
                ".validate": "newData.isNumber()"
              }
            }
          }
        }
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
